# Copy to deploy/hosted/ai-settings.env. Only the forecast worker reads these settings.
# Non-secret configuration only; keep the provider credential in /etc/mesoforge/ai.env.
# Provider and model remain in .env / the invoking environment (Compose defaults apply).
# Omit a line rather than leaving it blank: a present but empty budget is invalid.
# MESOFORGE_AI_REASONING_EFFORT=low
# MESOFORGE_AI_MIN_PROVIDER_INTERVAL_SECONDS=60
# MESOFORGE_AI_MAX_PROVIDER_CALLS=10
# MESOFORGE_AI_INPUT_USD_PER_MILLION=REPLACE_WITH_PRICE
# MESOFORGE_AI_OUTPUT_USD_PER_MILLION=REPLACE_WITH_PRICE
