# Copy to deploy/hosted/.env (never commit it). Compose interpolates these values.
# Generate every secret with `openssl rand -hex 24` (URL-safe inside the DSNs).

# Image tag printed by deploy/hosted/build-image.sh (one tag for every role).
MESOFORGE_IMAGE=mesoforge:REPLACE_WITH_COMMIT

# PostgreSQL: owner role (migrations, admin only) and least-privilege worker role.
MESOFORGE_PG_DB=mesoforge
MESOFORGE_PG_USER=mesoforge_owner
MESOFORGE_PG_PASSWORD=REPLACE_ME
MESOFORGE_PG_WORKER_USER=mesoforge_worker
MESOFORGE_PG_WORKER_PASSWORD=REPLACE_ME

# MinIO server root account (MinIO service only).
MESOFORGE_MINIO_ROOT_USER=mesoforge_root
MESOFORGE_MINIO_ROOT_PASSWORD=REPLACE_ME

# Application object-store credentials. Start with the MinIO root pair, or create a
# bucket-scoped MinIO user (README "Hosted deployment") and put it here instead.
# For an external S3-compatible provider, also set MESOFORGE_S3_ENDPOINT and give the
# admin service the egress network (it has no internet route by default).
MESOFORGE_S3_BUCKET=mesoforge-hosted
MESOFORGE_S3_ACCESS_KEY=REPLACE_ME
MESOFORGE_S3_SECRET_KEY=REPLACE_ME

# Optional; defaults shown. Both worker roles read the same schedule.
# MESOFORGE_S3_ENDPOINT=http://minio:9000
# MESOFORGE_FORECAST_TIMEZONE=America/Chicago
# MESOFORGE_FORECAST_TIMES=08:00,20:00
# MESOFORGE_GUIDANCE_MEM_LIMIT=8g
# MESOFORGE_FORECAST_MEM_LIMIT=6g
# Explicit opt-in: 120 builds five-day provisional policies; 36 preserves legacy operation.
# MESOFORGE_FORECAST_HORIZON_HOURS=36
# Daily v1 composition selects Minneapolis/120h/07:15 internally; email release is08:00.
# MESOFORGE_DAILY_IMAGE=mesoforge:REPLACE_WITH_EXACT_DAILY_CAPABLE_COMMIT
# Heavy Guidance admission: warning through30GiB, refusal below20GiB; never auto-delete.
# MESOFORGE_GUIDANCE_MIN_FREE_GB=20
# MESOFORGE_GUIDANCE_WARN_FREE_GB=30

# Forecast-only configuration; the credential itself is NEVER put in this file.
# MESOFORGE_AI_PROVIDER=openai
# MESOFORGE_AI_MODEL=gpt-6-sol
# MESOFORGE_AI_SECRET_FILE=/etc/mesoforge/ai.env
# Other non-secret AI overrides belong in ai-settings.env (see its example).
