# Non-secret SMTP settings. Copy to email-settings.env; never put a password here.
MESOFORGE_SMTP_HOST=smtp.example.com
MESOFORGE_SMTP_PORT=587
MESOFORGE_SMTP_SECURITY=starttls
MESOFORGE_SMTP_TIMEOUT_SECONDS=30
MESOFORGE_EMAIL_FROM=weather@example.com
# Provision MESOFORGE_SMTP_USERNAME and MESOFORGE_SMTP_PASSWORD securely in
# /etc/mesoforge/email.env on the host. Only the delivery role receives that file.
# Recipients are explicit command arguments, not forecast-science configuration.
