[importlinter]
root_packages =
    mesoforge
include_external_packages = True

[importlinter:contract:core-layers]
name = MesoForge Phase 0 core layering (application above provenance/catalog/contracts/common)
type = layers
layers =
    mesoforge.application
    mesoforge.provenance
    mesoforge.catalog
    mesoforge.contracts
    mesoforge.common

[importlinter:contract:phase1-domain-layers]
name = MesoForge Phase 1 domain layering (application composes pure Phase 1 domains)
type = layers
layers =
    mesoforge.application
    mesoforge.verification
    mesoforge.forecasting
    mesoforge.alignment
    mesoforge.observations
    mesoforge.guidance

[importlinter:contract:common-no-internal-deps]
name = common depends on no other mesoforge package (foundational layer)
type = forbidden
source_modules =
    mesoforge.common
forbidden_modules =
    mesoforge.contracts
    mesoforge.catalog
    mesoforge.provenance
    mesoforge.storage
    mesoforge.application
    mesoforge.guidance
    mesoforge.alignment
    mesoforge.forecasting
    mesoforge.observations
    mesoforge.verification

[importlinter:contract:common-no-heavy-infra]
name = common never imports storage/array infrastructure libraries
type = forbidden
source_modules =
    mesoforge.common
forbidden_modules =
    sqlalchemy
    psycopg
    alembic
    boto3
    xarray
    numpy
    h5netcdf
    pyproj

[importlinter:contract:domain-no-infrastructure]
name = contracts/catalog/provenance never import infrastructure libraries
type = forbidden
source_modules =
    mesoforge.contracts
    mesoforge.catalog
    mesoforge.provenance
forbidden_modules =
    boto3
    sqlalchemy
    psycopg
    alembic

[importlinter:contract:storage-interfaces-thin]
name = storage.interfaces contains protocols/contract types only, no infra imports
type = forbidden
source_modules =
    mesoforge.storage.interfaces
forbidden_modules =
    boto3
    sqlalchemy
    psycopg
    alembic
    h5netcdf

[importlinter:contract:phase1-pure-domains-no-infrastructure]
name = Phase 1 pure scientific domains never import storage/PostgreSQL/S3/application infrastructure
type = forbidden
source_modules =
    mesoforge.alignment
    mesoforge.forecasting
    mesoforge.verification
forbidden_modules =
    boto3
    sqlalchemy
    psycopg
    alembic
    mesoforge.storage
    mesoforge.application
    requests

[importlinter:contract:phase1-guidance-observations-network-isolation]
name = Only guidance.sources/observations.sources import network libraries; no storage/application leak
type = forbidden
source_modules =
    mesoforge.guidance.acquisition
    mesoforge.guidance.decoding
    mesoforge.guidance.normalization
    mesoforge.guidance.validation
    mesoforge.observations.normalization
    mesoforge.observations.quality
forbidden_modules =
    requests
    boto3
    sqlalchemy
    psycopg
    alembic
    mesoforge.storage
    mesoforge.application

[importlinter:contract:phase1-application-no-scientific-logic]
name = application.phase1 depends on domains only through their public modules, never a provider adapter directly
type = forbidden
source_modules =
    mesoforge.application.phase1
forbidden_modules =
    mesoforge.guidance.sources.hrrr
    mesoforge.observations.sources.aviationweather
ignore_imports =
    mesoforge.guidance.acquisition -> mesoforge.guidance.sources.hrrr
    mesoforge.observations.acquisition -> mesoforge.observations.sources.aviationweather

[importlinter:contract:phase2-coordinator-is-pure-composition]
name = application.phase2 contains no provider, adapter, science implementation, or infrastructure imports
type = forbidden
source_modules =
    mesoforge.application.phase2
forbidden_modules =
    mesoforge.application.phase2_adapters
    mesoforge.guidance.sources
    mesoforge.guidance.acquisition
    mesoforge.forecasting
    mesoforge.alignment
    mesoforge.observations
    mesoforge.verification
    mesoforge.storage
    requests
    boto3
    sqlalchemy
    psycopg
