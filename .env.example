# Copy to .env and fill in local, non-production values. Never commit .env.
MESOFORGE_PG_USER=mesoforge
MESOFORGE_PG_PASSWORD=mesoforge_local
MESOFORGE_PG_DB=mesoforge
MESOFORGE_PG_PORT=55432

MESOFORGE_MINIO_ROOT_USER=mesoforge_local
MESOFORGE_MINIO_ROOT_PASSWORD=mesoforge_local_password
MESOFORGE_MINIO_PORT=59000
MESOFORGE_MINIO_CONSOLE_PORT=59101

# Consumed by application code via os.environ using the name referenced
# from configs/environments/local.yaml (metadata_store.dsn_environment_variable).
MESOFORGE_DATABASE_DSN=postgresql+psycopg://mesoforge:mesoforge_local@localhost:55432/mesoforge

# Local/CI MinIO connection settings consumed by tests/integration/storage
# via os.environ (see tests/integration/storage/test_s3_object_store.py).
MESOFORGE_TEST_S3_ENDPOINT=http://127.0.0.1:59000
MESOFORGE_TEST_S3_ACCESS_KEY=mesoforge_local
MESOFORGE_TEST_S3_SECRET_KEY=mesoforge_local_password
MESOFORGE_TEST_S3_BUCKET=mesoforge-phase0-local
